{
  "name": "mertaydin/laravel-composer-monitor",
  "description": "A Laravel dashboard for Composer dependency health, outdated packages, security advisories and abandoned dependencies.",
  "keywords": [
    "laravel",
    "composer",
    "php",
    "dependency-monitoring",
    "dependency-management",
    "security",
    "audit",
    "outdated-packages",
    "composer-audit",
    "dashboard"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "laravel/pint": "^1.0",
    "larastan/larastan": "^2.9 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "MertAydin\\ComposerMonitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MertAydin\\ComposerMonitor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MertAydin\\ComposerMonitor\\ComposerMonitorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint --test",
    "analyse": "phpstan analyse --no-progress",
    "pint-test": "pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
